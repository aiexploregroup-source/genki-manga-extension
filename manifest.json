{
  "manifest_version": 3,
  "name": "Genki Manga — Japanese Study New Tab",
  "short_name": "Genki Manga",
  "version": "1.0.0",
  "description": "A colorful manga & anime themed Chrome new tab with the Genki I 30-Day Japanese challenge, kana charts, flashcards, quizzes, cute chibi mascots, anime backgrounds and full daily study reminders.",
  "permissions": ["alarms", "notifications", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Genki Manga Study",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
